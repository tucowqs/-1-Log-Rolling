--[[
	AssetLibrary — the Blender models. Each asset is a data module in ServerStorage.MeshData (generated by
	tools/gen_meshdata.js from the Blender pack dump). The SERVER (AssetBuildService) turns them into EditableMeshes and,
	through AssetService:CreateDataModelContentAsync, into session content that replicates to every client, then stores one
	Model per asset in ReplicatedStorage.Assets.<Category>.<Name> (Logs, Obstacles, Weights, World, Pets). Clients only clone those
	templates. An asset is a few MeshParts: one vertex-coloured "Body" plus its Glow (Neon) and recolourable regions
	(Main / Trim / Accent / SignFace), Studs material, anchored and non-colliding.
	If the place already holds an UPLOADED, wired model at Assets.<Category>.<Name> (re-run Blender import_pack with
	Upload = true once CreateAssetAsync is available over MCP) that one is used and nothing is built.
	  AssetLibrary.Build(name) -> Model?       server / edit mode: build the template (yields); clients: wait for it to replicate
	  AssetLibrary.Get(name) -> Model?         a fresh clone, or nil while the template doesn't exist yet
	  AssetLibrary.Wait(name) -> Model         yields until it exists, returns a clone
	  AssetLibrary.Preload(names, width?)      build (server) / wait (client), `width` at a time (default 1), started in order
	  AssetLibrary.Ready(name) -> boolean
]]
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local AssetLibrary = {}

local CATEGORY = { logs = "Logs", track_props = "Obstacles", hyper_only = "Obstacles", weights = "Weights", world_a = "World", world_b = "World", treadmill = "World", pets = "Pets", eggs = "Pets" }
local STUDS = "Studs" -- the MaterialVariant every non-Neon part wears (house look)

local keep: { EditableMesh } = {} -- only used when session content is refused (edit mode): a MeshPart then needs its EditableMesh alive
local waiting: { [string]: { thread } } = {}

local function folder(name: string): Folder
	local root = ReplicatedStorage:FindFirstChild("Assets")
	if not root then
		root = Instance.new("Folder")
		root.Name = "Assets"
		root.Parent = ReplicatedStorage
	end
	local f = root:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = root
	end
	return f
end

local function vec(t: { number }, i: number): Vector3
	return Vector3.new(t[i], t[i + 1], t[i + 2])
end

-- Parts that stay their own MeshPart: they need their own Material (Glow = Neon), a recolour (the obstacle / gate
-- regions the scenery tints per area) or a SurfaceGui (the gate sign). Everything else of an asset is merged into one
-- vertex-coloured mesh named "Body": fewer meshes means less to build, store and replicate.
local function separate(name: string): boolean
	-- Lid* = the FreeChest lid (ChestController swings it open)
	return name:match("^Glow") ~= nil or name:match("^Lid") ~= nil or name == "Main" or name == "Trim" or name == "Accent" or name == "SignFace"
end

-- One EditableMesh from parts (flat shaded; per-face colour from each part when `colored`). Vertices are offset by
-- `origin` so the mesh is centred on its bounding box.
local function mesh(parts, origin: Vector3, colored: boolean): EditableMesh
	local em = AssetService:CreateEditableMesh()
	local colors = {}
	for _, part in parts do
		local shift = vec(part.Center, 1) - origin
		local ids = table.create(#part.Verts // 3)
		for i = 1, #part.Verts, 3 do
			table.insert(ids, em:AddVertex(vec(part.Verts, i) + shift))
		end
		local key = part.Color[1] * 65536 + part.Color[2] * 256 + part.Color[3]
		if colored then
			colors[key] = colors[key] or em:AddColor(Color3.fromRGB(part.Color[1], part.Color[2], part.Color[3]), 1)
		end
		for i = 1, #part.Tris, 3 do
			local a, b, c = ids[part.Tris[i] + 1], ids[part.Tris[i + 1] + 1], ids[part.Tris[i + 2] + 1]
			local n = (em:GetPosition(b) - em:GetPosition(a)):Cross(em:GetPosition(c) - em:GetPosition(a))
			if n.Magnitude > 1e-6 then
				local normal = em:AddNormal(n.Unit) -- flat shaded: one normal per face
				local face = em:AddTriangle(a, b, c)
				em:SetFaceNormals(face, { normal, normal, normal })
				if colored then
					em:SetFaceColors(face, { colors[key], colors[key], colors[key] })
				end
			end
		end
	end
	return em
end

local function bounds(parts): Vector3
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, part in parts do
		local center = vec(part.Center, 1)
		for i = 1, #part.Verts, 3 do
			local p = vec(part.Verts, i) + center
			lo, hi = lo:Min(p), hi:Max(p)
		end
	end
	return (lo + hi) / 2
end

local function meshPart(parts, name: string, neon: boolean): MeshPart
	local origin = bounds(parts)
	local editable = mesh(parts, origin, name == "Body")
	-- Session content replicates to clients and frees the EditableMesh. (Edit mode may refuse it: then the
	-- EditableMesh itself is the content and must stay alive.)
	local ok, result, content = pcall(AssetService.CreateDataModelContentAsync, AssetService, Content.fromObject(editable))
	if ok and result == Enum.CreateContentResult.Success then
		editable:Destroy()
	else
		content = Content.fromObject(editable)
		table.insert(keep, editable)
	end
	local mp = AssetService:CreateMeshPartAsync(content, { CollisionFidelity = Enum.CollisionFidelity.Box })
	mp.Name = name
	-- the merged Body wears its colours as vertex colours (white tint); a lone part carries its colour as a property
	mp.Color = if name == "Body" then Color3.new(1, 1, 1) else Color3.fromRGB(parts[1].Color[1], parts[1].Color[2], parts[1].Color[3])
	if neon then
		mp.Material = Enum.Material.Neon
	else
		mp.Material = Enum.Material.Plastic
		mp.MaterialVariant = STUDS
	end
	mp.Anchored, mp.CanCollide, mp.CanTouch, mp.CanQuery, mp.CastShadow = true, false, false, false, false
	mp.CFrame = CFrame.new(origin)
	return mp
end

-- Runs every job at once and returns when all are done (each job yields on the engine's async calls, so they overlap).
local function together(jobs: { () -> () })
	local left, main, parked = #jobs, coroutine.running(), false
	for _, job in jobs do
		task.spawn(function()
			local ok, err = pcall(job)
			if not ok then
				warn("[AssetLibrary] " .. tostring(err))
			end
			left -= 1
			if left == 0 and parked then
				task.spawn(main)
			end
		end)
	end
	if left > 0 then
		parked = true
		coroutine.yield()
	end
end

local function build(data): Model
	local model = Instance.new("Model")
	model.Name = data.Name
	local merged, jobs = {}, {}
	for _, part in data.Parts do
		if separate(part.Name) then
			table.insert(jobs, function()
				meshPart({ part }, part.Name, part.Name:match("^Glow") ~= nil).Parent = model
			end)
		else
			table.insert(merged, part)
		end
	end
	if #merged > 0 then
		table.insert(jobs, function()
			meshPart(merged, "Body", false).Parent = model
		end)
	end
	together(jobs) -- the parts' content uploads overlap instead of queueing
	model.WorldPivot = CFrame.new() -- pivot = the Blender origin (ground centre / log centre)
	return model
end

local function find(name: string): Model?
	local root = ReplicatedStorage:FindFirstChild("Assets")
	if root then
		for _, category in root:GetChildren() do
			local model = category:FindFirstChild(name)
			if model and model:IsA("Model") then
				return model
			end
		end
	end
	return nil
end

function AssetLibrary.Ready(name: string): boolean
	return find(name) ~= nil
end

function AssetLibrary.Build(name: string): Model?
	local existing = find(name)
	if existing then
		return existing
	end
	local module = ServerStorage:FindFirstChild("MeshData") and ServerStorage.MeshData:FindFirstChild(name)
	if not module then
		-- a client: the server publishes the template into ReplicatedStorage.Assets
		local waited = 0
		while not find(name) and waited < 90 do
			waited += task.wait(0.25)
		end
		return find(name)
	end
	if waiting[name] then
		table.insert(waiting[name], coroutine.running())
		coroutine.yield()
		return find(name)
	end
	waiting[name] = {}
	local data = require(module)
	local model = build(data)
	model.Parent = folder(CATEGORY[data.Group] or "World")
	for _, thread in waiting[name] do
		task.spawn(thread)
	end
	waiting[name] = nil
	return model
end

function AssetLibrary.Get(name: string): Model?
	local template = find(name)
	return template and template:Clone()
end

function AssetLibrary.Wait(name: string): Model
	return (AssetLibrary.Build(name) :: Model):Clone()
end

function AssetLibrary.Preload(names: { string }, width: number?)
	local nextIndex = 0
	local workers = {}
	for _ = 1, math.min(width or 1, #names) do
		table.insert(workers, function()
			while true do
				nextIndex += 1
				local name = names[nextIndex]
				if not name then
					return
				end
				local ok, err = pcall(AssetLibrary.Build, name)
				if not ok then
					warn("[AssetLibrary] " .. name .. ": " .. tostring(err))
				end
			end
		end)
	end
	together(workers)
end

return AssetLibrary
